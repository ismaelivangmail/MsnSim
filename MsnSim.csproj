<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MsnSim</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>MsnSim</ApplicationTitle>
    <ApplicationId>com.ivanovsky.msnsim</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <!-- Genera .apk (no .aab) también en Release -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Incluye ARM de 32 bits (p. ej. Redmi 9A) además de 64 bits -->
    <RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>
    <!-- sqlite-net usa reflexión: no recortar el ensamblado de la app -->
    <TrimMode>partial</TrimMode>
    <!-- Avisos de APIs marcadas obsoletas en MAUI 10 (DisplayAlert, TranslateTo...) -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1D5FA8" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1D5FA8" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
  </ItemGroup>

</Project>
